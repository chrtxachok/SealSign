{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SealSign prediction v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "model_version",
    "image",
    "detections",
    "timing_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class_id",
          "label",
          "confidence",
          "bbox_xyxy"
        ],
        "properties": {
          "class_id": {
            "enum": [
              0,
              1
            ]
          },
          "label": {
            "enum": [
              "stamp",
              "signature"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bbox_xyxy": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "oneOf": [
          {
            "properties": {
              "class_id": {
                "const": 0
              },
              "label": {
                "const": "stamp"
              }
            }
          },
          {
            "properties": {
              "class_id": {
                "const": 1
              },
              "label": {
                "const": "signature"
              }
            }
          }
        ]
      }
    },
    "timing_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preprocess",
        "inference",
        "postprocess"
      ],
      "properties": {
        "preprocess": {
          "type": "number",
          "minimum": 0
        },
        "inference": {
          "type": "number",
          "minimum": 0
        },
        "postprocess": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
